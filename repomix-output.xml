              letterSpacing: 0.5,
            ),
          ),
          const SizedBox(height: 8),
          TextFormField(
            controller: controller,
            obscureText: obscureText,
            validator:
                validator ??
                (value) => value!.isEmpty ? "Tidak boleh kosong" : null,
