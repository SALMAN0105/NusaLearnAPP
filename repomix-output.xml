                        text: TextSpan(
                          children: [
                            TextSpan(
                              text: "Nusa",
                              style: GoogleFonts.poppins(
                                fontSize: 24,
                                fontWeight: FontWeight.bold,
                                color: Colors.black87,
                              ),
                            ),
                            TextSpan(
                              text: "Quiz",
                              style: GoogleFonts.poppins(
