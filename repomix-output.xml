                                ),
                                isActive: !_useLocalLanguage,
                                onTap: () => _switchLanguage(false),
                              ),
                              const SizedBox(height: 32),

                              _buildSectionTitle("BAHASA DAERAH (ADAPTIF AI)"),
                              _buildLanguageItem(
                                title: _userLanguageName ?? "Bahasa Daerah",
                                subtitle: _isDictionaryReady
                                    ? "Siap digunakan"
