      // 2. DEFENSIVE OVERRIDE: Sinkronkan juga nama jika perlu
      final dbName = userData['name'] as String?;
      if (dbName != null && dbName.trim().isNotEmpty) {
        name = dbName;
        await prefs.setString('user_name', name);
      }
