  final List<String> _categories = ["Semua", "Literasi", "Numerasi", "Budaya"];

  int _selectedLevel = 0;
  final List<int> _levels = [0, 1, 2, 3];

  @override
  void initState() {
    super.initState();
    _loadHeaderData();
    _loadAvailableQuizzesWithProgress();
