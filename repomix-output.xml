              ),
            ),
            if (showDownloadIcon)
              Container(
                padding: const EdgeInsets.all(8),
                decoration: BoxDecoration(
                  color: const Color(0xFFFFDEB3), // Orange paste
                  shape: BoxShape.circle,
                  border: Border.all(color: kBlack, width: 1.5),
                ),
