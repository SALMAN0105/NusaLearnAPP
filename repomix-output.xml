      setState(() {
        _userName = name;
        _school = school;

        _totalRead = Sqflite.firstIntValue(countRead) ?? 0;
        _quizCorrect = Sqflite.firstIntValue(countQuiz) ?? 0;

        // INJEKSI MATEMATIKA: 5 Jawaban Benar = 1 Level
